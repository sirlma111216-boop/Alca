{
  // ────────────────────────────────────────────────────────────────────────
  // 브릭픽 BrickPick — Cloudflare Workers 배포 설정
  //
  // 배포 방법
  //   npm run build:app      → dist/ 를 만든다
  //   npx wrangler deploy    → dist/ + Worker 를 올린다   (= npm run deploy:workers)
  //
  // 이 설정은 두 가지를 함께 올린다.
  //   ① 게임 화면(정적 파일)  — Worker 를 **거치지 않고** Cloudflare 가 바로 내려준다
  //   ② 실시간 참여 서버      — /ws 와 /api/* 에서만 Worker 가 돈다
  //
  // ②가 없으면 학생 폰으로 동시에 참여할 수 없다(단독 실행과 iframe 연동은 ① 만으로 된다).
  //
  // 요금: 정적 파일 요청은 과금 대상이 아니고, WebSocket 은 처음 연결만 요청 1건으로 센다.
  //       한 반 30명이 한 차시를 하면 요청 수십 건 수준이라 무료 요금제 안에서 끝난다.
  //
  // 헤더(보안·iframe 허용 목록)는 이 파일이 아니라 public/_headers 에 적는다.
  // ────────────────────────────────────────────────────────────────────────

  "$schema": "node_modules/wrangler/config-schema.json",

  // 배포 이름. 기본 주소(brickpick.<계정>.workers.dev)에 쓰인다.
  "name": "brickpick",

  // Cloudflare 런타임의 동작 기준 날짜.
  "compatibility_date": "2025-01-01",

  // Durable Object 와 WebSocket hibernation 을 쓰려면 필요하다.
  "compatibility_flags": ["nodejs_compat"],

  // 실시간 참여 서버. 이 파일이 /ws 와 /api/* 만 처리한다.
  "main": "worker/index.ts",

  "assets": {
    // 올릴 폴더. 앱 빌드 출력이다(vite.config.ts 의 build.outDir).
    // 라이브러리 출력 dist-lib/ 는 npm 패키지용이라 올리지 않는다.
    "directory": "./dist",

    // Worker 코드에서 정적 파일을 꺼내 쓸 때의 이름.
    "binding": "ASSETS",

    // 주소 → 파일 찾는 방식. /embed/ 와 /embed 를 둘 다 dist/embed/index.html 로 이어 준다.
    "html_handling": "auto-trailing-slash",

    // 없는 주소는 dist/404.html 을 404 상태로 돌려준다.
    // "single-page-application" 을 쓰면 오타 주소(/embedd)가 조용히 앱을 열어 버린다.
    "not_found_handling": "404-page",

    // ★ 여기가 핵심이다.
    // 목록에 적은 경로에서만 Worker 가 먼저 돈다. 나머지(게임 화면·JS·CSS)는
    // 예전처럼 Cloudflare 가 바로 내려주므로 속도도 요금도 그대로다.
    // true 로 두면 **모든 요청**이 Worker 를 거쳐 느려지고 요금이 는다 — 쓰지 않는다.
    "run_worker_first": ["/ws", "/api/*"]
  },

  // 수업 하나 = 객체 하나. idFromName(코드) 로 찾으므로 외부 데이터베이스가 필요 없다.
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomSession" }]
  },

  // new_sqlite_classes 여야 **무료 요금제**에서 쓸 수 있다. new_classes 는 유료다.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomSession"] }],

  // 배포 로그·오류를 Cloudflare 대시보드에서 보려면 켠다. 개인정보는 남기지 않는다.
  "observability": {
    "enabled": true
  }
}
